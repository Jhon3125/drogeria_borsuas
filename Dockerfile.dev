
FROM node:22-bookworm-slim

RUN apt-get update \
    && apt-get install -y openssl ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

EXPOSE 3000

CMD ["sh", "-c", "set -e; HASH=$(sha256sum package.json package-lock.json | sha256sum | cut -d ' ' -f 1); if [ ! -x node_modules/.bin/next ] || [ \"$HASH\" != \"$(cat node_modules/.deps-hash 2>/dev/null || true)\" ]; then echo 'Instalando dependencias...'; npm ci --include=dev; echo \"$HASH\" > node_modules/.deps-hash; else echo 'Dependencias actualizadas. Omitiendo instalacion.'; fi; npx prisma generate; exec npm run dev -- --webpack --hostname 0.0.0.0 --port 3000"]
