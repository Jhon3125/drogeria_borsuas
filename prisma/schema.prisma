// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS (Listas de valores fijos)
// ==========================================

enum RolUsuario {
  SUPER_ADMIN
  ADMIN
  COMERCIAL
  COMPRAS
  ALMACEN
  CONDUCTOR
}

enum EstadoUsuario {
  ACTIVO
  INACTIVO
  BLOQUEADO
}

enum MetodoPago {
  EFECTIVO
  TRANSFERENCIA
  TARJETA
  CREDITO
}

enum TipoMovimiento {
  ENTRADA_COMPRA
  SALIDA_VENTA
  AJUSTE_POSITIVO
  AJUSTE_NEGATIVO
}

enum EstadoDespacho {
  PENDIENTE
  EN_RUTA
  ENTREGADO
  REPROGRAMADO
}

enum Moneda {
  PEN
  USD
}

enum EstadoOrdenPago {
  SOLICITADA
  APROBADA
  RECHAZADA
  PAGO_PARCIAL
  PAGADA
}

enum MetodoDesembolso {
  TRANSFERENCIA
  EFECTIVO
  CHEQUE
  OTRO
}

enum AccionHistorialOrdenPago {
  CREACION
  APROBACION
  RECHAZO
  REGISTRO_DESEMBOLSO
}

enum EstadoCalidadLote {
  DISPONIBLE
  CUARENTENA
  BLOQUEADO
}

enum AccionCalidadLote {
  CAMBIO_ESTADO
}

enum EstadoRetencionLote {
  ACTIVA
  LIBERADA
}

enum EtapaOportunidad {
  PROSPECTO
  CONTACTADO
  COTIZACION
  NEGOCIACION
  GANADA
  PERDIDA
}

enum EstadoVenta {
  CONFIRMADA
  EN_PREPARACION
  DESPACHADA
  COMPLETADA
  ANULADA
}

enum EstadoRelacionComercial {
  PROSPECTO
  CALIFICADO
  DESCARTADO
}

enum TipoActividadComercial {
  LLAMADA
  WHATSAPP
  CORREO
  VISITA
  OTRO
  CALIFICACION
}

enum ResultadoActividadComercial {
  CONTACTO_EFECTIVO
  SIN_RESPUESTA
  REPROGRAMADO
  SIN_INTERES
  CALIFICADO
}

// ==========================================
// MÓDULO 1: USUARIOS Y ROLES (H0001, H0002)
// ==========================================

model Usuario {
  id               Int           @id @default(autoincrement())
  email            String        @unique
  passwordHash     String
  nombre           String
  rol              RolUsuario
  estado           EstadoUsuario @default(ACTIVO)
  intentosFallidos Int           @default(0)
  creadoEn         DateTime      @default(now())
  actualizadoEn    DateTime      @updatedAt

  // Relaciones
  ventas                   Venta[]                @relation("Vendedor")
  hojasDeRuta              HojaRuta[]             @relation("Conductor")
  gastos                   Gasto[]                @relation("ResponsableGasto")
  recepcionesCompra        RecepcionCompra[]      @relation("ResponsableRecepcion")
  movimientosInventario    MovimientoInventario[] @relation("ResponsableMovimiento")
  ordenesPagoSolicitadas   OrdenPago[]            @relation("OrdenPagoSolicitante")
  ordenesPagoAutorizadas   OrdenPago[]            @relation("OrdenPagoAutorizador")
  desembolsosRegistrados   DesembolsoPago[]       @relation("ResponsableDesembolso")
  historialOrdenesPago     HistorialOrdenPago[]   @relation("ResponsableHistorialOrdenPago")
  historialCalidadLotes    HistorialCalidadLote[] @relation("ResponsableCalidadLote")
  retencionesRegistradas   RetencionLote[]        @relation("RetencionRegistradaPor")
  retencionesLiberadas     RetencionLote[]        @relation("RetencionLiberadaPor")
  oportunidadesComerciales OportunidadComercial[] @relation("ResponsableOportunidad")
  historialOportunidades   HistorialOportunidad[] @relation("ResponsableHistorialOportunidad")
  cotizaciones             Cotizacion[]           @relation("VendedorCotizacion")
  actividadesComerciales   ActividadComercial[]   @relation("ResponsableActividadComercial")
}

// ==========================================
// MÓDULO 2: CATÁLOGO DE PRODUCTOS (H0003)
// ==========================================

model Categoria {
  id          Int        @id @default(autoincrement())
  nombre      String     @unique
  descripcion String?
  productos   Producto[]
}

model Producto {
  id           Int     @id @default(autoincrement())
  codigo       String  @unique
  nombre       String
  descripcion  String?
  precioCompra Decimal @default(0) @db.Decimal(12, 2)
  precioVenta  Decimal @default(0) @db.Decimal(12, 2)
  moneda       Moneda  @default(PEN)
  unidadMedida String
  stockMinimo  Int     @default(0)
  stockActual  Int     @default(0)
  estado       Boolean @default(true)
  categoriaId  Int

  // Relaciones
  categoria          Categoria              @relation(fields: [categoriaId], references: [id])
  lotes              Lote[]
  movimientos        MovimientoInventario[]
  detallesCompra     DetalleCompra[]
  detallesVenta      DetalleVenta[]
  detallesCotizacion DetalleCotizacion[]
}

// ==========================================
// MÓDULO 3: PROVEEDORES, COMPRAS, LOTES E INVENTARIO (H0004, H0005)
// ==========================================

model Proveedor {
  id          Int     @id @default(autoincrement())
  razonSocial String
  ruc         String  @unique
  contacto    String?
  telefono    String?
  correo      String?
  direccion   String?
  estado      Boolean @default(true)

  compras Compra[]
}

model Compra {
  id                   Int       @id @default(autoincrement())
  proveedorId          Int
  fecha                DateTime  @default(now())
  fechaEntregaEstimada DateTime?
  observaciones        String?
  importeTotal         Decimal   @db.Decimal(12, 2)
  moneda               Moneda    @default(PEN)
  tipoCambio           Decimal?  @db.Decimal(12, 6)
  estado               String    @default("COMPLETADO")

  proveedor   Proveedor         @relation(fields: [proveedorId], references: [id])
  detalles    DetalleCompra[]
  recepciones RecepcionCompra[]
  ordenesPago OrdenPago[]
}

model DetalleCompra {
  id             Int     @id @default(autoincrement())
  compraId       Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)

  // Compatibilidad con órdenes antiguas.
  // Las órdenes nuevas no registrarán estos datos aquí.
  numeroLote       String?
  fechaVencimiento DateTime?

  compra      Compra            @relation(fields: [compraId], references: [id])
  producto    Producto          @relation(fields: [productoId], references: [id])
  recepciones RecepcionCompra[]
}

model Lote {
  id                 Int      @id @default(autoincrement())
  numeroLote         String
  productoId         Int
  cantidadInicial    Int
  cantidadDisponible Int
  fechaIngreso       DateTime @default(now())
  fechaVencimiento   DateTime

  producto          Producto               @relation(fields: [productoId], references: [id])
  estadoCalidad     EstadoCalidadLote      @default(DISPONIBLE)
  historialCalidad  HistorialCalidadLote[]
  movimientos       MovimientoInventario[]
  recepciones       RecepcionCompra[]
  retenciones       RetencionLote[]
  asignacionesVenta AsignacionLoteVenta[]

  @@unique([numeroLote, productoId])
}

/// Registra una cantidad recibida realmente, incluso en entregas parciales.
/// Una compra antigua RECIBIDO no se migra a recepción ficticia.
model RecepcionCompra {
  id              Int      @id @default(autoincrement())
  compraId        Int
  detalleCompraId Int
  loteId          Int
  usuarioId       Int?
  cantidad        Int
  fecha           DateTime @default(now())

  compra        Compra        @relation(fields: [compraId], references: [id], onDelete: Restrict)
  detalleCompra DetalleCompra @relation(fields: [detalleCompraId], references: [id], onDelete: Restrict)
  lote          Lote          @relation(fields: [loteId], references: [id], onDelete: Restrict)
  usuario       Usuario?      @relation("ResponsableRecepcion", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([compraId])
  @@index([detalleCompraId])
  @@index([loteId])
  @@index([usuarioId])
}

model MovimientoInventario {
  id         Int            @id @default(autoincrement())
  productoId Int
  loteId     Int?
  usuarioId  Int?
  tipo       TipoMovimiento
  cantidad   Int
  fecha      DateTime       @default(now())
  motivo     String?

  producto Producto @relation(fields: [productoId], references: [id])
  lote     Lote?    @relation(fields: [loteId], references: [id])
  usuario  Usuario? @relation("ResponsableMovimiento", fields: [usuarioId], references: [id], onDelete: SetNull)

  @@index([usuarioId])
  @@index([fecha])
}

model HistorialCalidadLote {
  id             Int               @id @default(autoincrement())
  loteId         Int
  usuarioId      Int
  accion         AccionCalidadLote @default(CAMBIO_ESTADO)
  estadoAnterior EstadoCalidadLote
  estadoNuevo    EstadoCalidadLote
  motivo         String            @db.VarChar(500)
  fecha          DateTime          @default(now())

  lote    Lote    @relation(fields: [loteId], references: [id], onDelete: Restrict)
  usuario Usuario @relation("ResponsableCalidadLote", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([loteId, fecha])
  @@index([usuarioId])
}

model RetencionLote {
  id               Int                 @id @default(autoincrement())
  loteId           Int
  cantidad         Int
  motivo           String              @db.VarChar(500)
  estado           EstadoRetencionLote @default(ACTIVA)
  registradoPorId  Int
  fechaRegistro    DateTime            @default(now())
  liberadoPorId    Int?
  fechaLiberacion  DateTime?
  motivoLiberacion String?             @db.VarChar(500)

  lote          Lote     @relation(fields: [loteId], references: [id], onDelete: Restrict)
  registradoPor Usuario  @relation("RetencionRegistradaPor", fields: [registradoPorId], references: [id], onDelete: Restrict)
  liberadoPor   Usuario? @relation("RetencionLiberadaPor", fields: [liberadoPorId], references: [id], onDelete: Restrict)

  @@index([loteId, estado])
  @@index([fechaRegistro])
}

// ==========================================
// MÓDULO 4: CRM, CLIENTES, COTIZACIONES Y VENTAS (H0006, H0007, H0008, H0009)
// ==========================================

model Cliente {
  id          Int     @id @default(autoincrement())
  razonSocial String
  documento   String? @unique
  telefono    String?
  correo      String?
  direccion   String?
  estado      Boolean @default(true)

  ventas        Venta[]
  oportunidades OportunidadComercial[]
  cotizaciones  Cotizacion[]

  estadoRelacionComercial EstadoRelacionComercial @default(PROSPECTO)
  fechaCalificacion       DateTime?
}

model Venta {
  id             Int         @id @default(autoincrement())
  clienteId      Int
  vendedorId     Int
  fecha          DateTime    @default(now())
  subtotal       Decimal     @default(0) @db.Decimal(12, 2)
  descuento      Decimal     @default(0) @db.Decimal(12, 2)
  importeTotal   Decimal     @db.Decimal(12, 2)
  estado         EstadoVenta @default(CONFIRMADA)
  metodoPago     MetodoPago?
  saldoPendiente Decimal     @default(0) @db.Decimal(12, 2)

  cliente       Cliente               @relation(fields: [clienteId], references: [id])
  vendedor      Usuario               @relation("Vendedor", fields: [vendedorId], references: [id])
  detalles      DetalleVenta[]
  pagos         Pago[]
  despachos     Despacho[]
  oportunidadId Int?
  cotizacionId  Int?                  @unique
  oportunidad   OportunidadComercial? @relation(fields: [oportunidadId], references: [id])
  cotizacion    Cotizacion?           @relation(fields: [cotizacionId], references: [id])
  moneda        Moneda                @default(PEN)

  @@index([clienteId])
  @@index([vendedorId])
  @@index([oportunidadId])
  @@index([estado])
}

model DetalleVenta {
  id             Int     @id @default(autoincrement())
  ventaId        Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  descuento      Decimal @default(0) @db.Decimal(12, 2)

  venta    Venta    @relation(fields: [ventaId], references: [id])
  producto Producto @relation(fields: [productoId], references: [id])

  asignacionesLote AsignacionLoteVenta[]

  @@index([ventaId])
  @@index([productoId])
}

model AsignacionLoteVenta {
  id              Int      @id @default(autoincrement())
  detalleVentaId  Int
  loteId          Int
  cantidad        Int
  fechaAsignacion DateTime @default(now())

  detalleVenta DetalleVenta @relation(fields: [detalleVentaId], references: [id], onDelete: Restrict)
  lote         Lote         @relation(fields: [loteId], references: [id], onDelete: Restrict)

  detallesDespacho DetalleDespacho[]

  @@unique([detalleVentaId, loteId])
  @@index([loteId])
}

model Pago {
  id         Int        @id @default(autoincrement())
  ventaId    Int
  monto      Decimal    @db.Decimal(12, 2)
  fecha      DateTime   @default(now())
  metodoPago MetodoPago

  venta Venta @relation(fields: [ventaId], references: [id])
}

enum EstadoCotizacion {
  BORRADOR
  EMITIDA
  ACEPTADA
  RECHAZADA
  VENCIDA
  ANULADA
}

model Cotizacion {
  id            Int              @id @default(autoincrement())
  oportunidadId Int?
  clienteId     Int
  vendedorId    Int
  fecha         DateTime         @default(now())
  validezHasta  DateTime?
  estado        EstadoCotizacion @default(BORRADOR)

  // Versionamiento de cotizaciones
  version              Int  @default(1)
  cotizacionAnteriorId Int? @unique

  moneda       Moneda  @default(PEN)
  subtotal     Decimal @default(0) @db.Decimal(12, 2)
  descuento    Decimal @default(0) @db.Decimal(12, 2)
  importeTotal Decimal @db.Decimal(12, 2)

  condicionPago String? @db.VarChar(100)
  plazoEntrega  String? @db.VarChar(150)
  observaciones String? @db.Text

  detalles DetalleCotizacion[]

  venta Venta?

  cliente            Cliente               @relation(fields: [clienteId], references: [id])
  vendedor           Usuario               @relation("VendedorCotizacion", fields: [vendedorId], references: [id])
  oportunidad        OportunidadComercial? @relation(fields: [oportunidadId], references: [id])
  cotizacionAnterior Cotizacion?           @relation("RevisionesCotizacion", fields: [cotizacionAnteriorId], references: [id], onDelete: Restrict)
  revisionSiguiente  Cotizacion?           @relation("RevisionesCotizacion")

  @@index([clienteId])
  @@index([vendedorId])
  @@index([oportunidadId])
  @@index([estado])
}

model DetalleCotizacion {
  id             Int     @id @default(autoincrement())
  cotizacionId   Int
  productoId     Int
  cantidad       Int
  precioUnitario Decimal @db.Decimal(12, 2)
  descuento      Decimal @default(0) @db.Decimal(12, 2)

  cotizacion Cotizacion @relation(fields: [cotizacionId], references: [id])
  producto   Producto   @relation(fields: [productoId], references: [id])

  @@index([cotizacionId])
  @@index([productoId])
}

model OportunidadComercial {
  id         Int              @id @default(autoincrement())
  titulo     String           @db.VarChar(180)
  clienteId  Int
  vendedorId Int
  etapa      EtapaOportunidad @default(PROSPECTO)

  montoEstimado Decimal? @db.Decimal(12, 2)
  moneda        Moneda   @default(PEN)

  descripcion      String?   @db.Text
  proximaActividad String?   @db.VarChar(300)
  fechaSeguimiento DateTime?
  motivoPerdida    String?   @db.Text

  fechaCreacion      DateTime  @default(now())
  fechaActualizacion DateTime  @updatedAt
  fechaCierre        DateTime?

  cliente  Cliente @relation(fields: [clienteId], references: [id], onDelete: Restrict)
  vendedor Usuario @relation("ResponsableOportunidad", fields: [vendedorId], references: [id], onDelete: Restrict)

  historial    HistorialOportunidad[]
  cotizaciones Cotizacion[]
  ventas       Venta[]
  actividades  ActividadComercial[]

  @@index([clienteId])
  @@index([vendedorId])
  @@index([etapa])
  @@index([fechaSeguimiento])
  @@index([fechaCreacion])
}

model HistorialOportunidad {
  id            Int @id @default(autoincrement())
  oportunidadId Int
  usuarioId     Int

  etapaAnterior EtapaOportunidad?
  etapaNueva    EtapaOportunidad

  comentario  String?  @db.Text
  fechaCambio DateTime @default(now())

  oportunidad OportunidadComercial @relation(fields: [oportunidadId], references: [id], onDelete: Restrict)
  usuario     Usuario              @relation("ResponsableHistorialOportunidad", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([oportunidadId, fechaCambio])
  @@index([usuarioId])
}

model ActividadComercial {
  id              Int                         @id @default(autoincrement())
  oportunidadId   Int
  usuarioId       Int
  tipo            TipoActividadComercial
  resultado       ResultadoActividadComercial
  personaContacto String?                     @db.VarChar(120)
  observaciones   String                      @db.Text
  fecha           DateTime                    @default(now())
  oportunidad     OportunidadComercial        @relation(fields: [oportunidadId], references: [id], onDelete: Restrict)
  usuario         Usuario                     @relation("ResponsableActividadComercial", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([oportunidadId, fecha])
  @@index([usuarioId])
}

// ==========================================
// MÓDULO 5: CAJA Y GASTOS OPERATIVOS (H0009)
// ==========================================

model Gasto {
  id            Int        @id @default(autoincrement())
  tipoGasto     String
  descripcion   String?
  monto         Decimal    @db.Decimal(12, 2)
  fecha         DateTime   @default(now())
  responsableId Int
  medioPago     MetodoPago

  responsable Usuario @relation("ResponsableGasto", fields: [responsableId], references: [id])
}

// ==========================================
// MÓDULO 6: LOGÍSTICA Y DESPACHOS (H0010, H0011, H0012)
// ==========================================

model Vehiculo {
  id        Int     @id @default(autoincrement())
  placa     String  @unique
  modelo    String
  capacidad String
  estado    Boolean @default(true)

  hojasDeRuta HojaRuta[]
}

model HojaRuta {
  id          Int      @id @default(autoincrement())
  conductorId Int
  vehiculoId  Int
  fecha       DateTime @default(now())
  estado      String   @default("ASIGNADO")

  conductor Usuario    @relation("Conductor", fields: [conductorId], references: [id])
  vehiculo  Vehiculo   @relation(fields: [vehiculoId], references: [id])
  despachos Despacho[]
}

model Despacho {
  id                 Int            @id @default(autoincrement())
  hojaRutaId         Int?
  ventaId            Int
  estado             EstadoDespacho @default(PENDIENTE)
  observacion        String?
  fechaCreacion      DateTime       @default(now())
  fechaActualizacion DateTime       @updatedAt

  hojaRuta HojaRuta?         @relation(fields: [hojaRutaId], references: [id], onDelete: SetNull)
  venta    Venta             @relation(fields: [ventaId], references: [id], onDelete: Restrict)
  detalles DetalleDespacho[]

  @@index([ventaId])
  @@index([hojaRutaId])
  @@index([estado])
}

model DetalleDespacho {
  id                    Int @id @default(autoincrement())
  despachoId            Int
  asignacionLoteVentaId Int
  cantidad              Int

  despacho            Despacho            @relation(fields: [despachoId], references: [id], onDelete: Restrict)
  asignacionLoteVenta AsignacionLoteVenta @relation(fields: [asignacionLoteVentaId], references: [id], onDelete: Restrict)

  @@unique([despachoId, asignacionLoteVentaId])
  @@index([asignacionLoteVentaId])
}

/// Solicitud y autorización de pago asociada a una Orden de Compra.
/// El monto solicitado debe estar respaldado por recepciones reales.
model OrdenPago {
  id            Int             @id @default(autoincrement())
  compraId      Int
  solicitanteId Int
  autorizadorId Int?
  estado        EstadoOrdenPago @default(SOLICITADA)

  montoSolicitado Decimal @db.Decimal(12, 2)
  moneda          Moneda

  numeroFactura String? @db.VarChar(100)
  observaciones String? @db.Text
  motivoRechazo String? @db.Text

  fechaSolicitud     DateTime  @default(now())
  fechaAutorizacion  DateTime?
  fechaActualizacion DateTime  @updatedAt

  compra Compra @relation(fields: [compraId], references: [id], onDelete: Restrict)

  solicitante Usuario @relation("OrdenPagoSolicitante", fields: [solicitanteId], references: [id], onDelete: Restrict)

  autorizador Usuario? @relation("OrdenPagoAutorizador", fields: [autorizadorId], references: [id], onDelete: Restrict)

  desembolsos DesembolsoPago[]
  historial   HistorialOrdenPago[]

  @@index([compraId])
  @@index([estado])
  @@index([fechaSolicitud])
  @@index([solicitanteId])
  @@index([autorizadorId])
}

model DesembolsoPago {
  id                Int     @id @default(autoincrement())
  ordenPagoId       Int
  responsableId     Int
  claveIdempotencia String? @unique @db.VarChar(36)

  monto         Decimal          @db.Decimal(12, 2)
  metodo        MetodoDesembolso
  referencia    String?          @db.VarChar(150)
  observaciones String?          @db.Text

  fechaPago     DateTime
  fechaRegistro DateTime @default(now())

  ordenPago OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Restrict)

  responsable Usuario @relation("ResponsableDesembolso", fields: [responsableId], references: [id], onDelete: Restrict)

  @@index([ordenPagoId])
  @@index([responsableId])
  @@index([fechaPago])
}

model HistorialOrdenPago {
  id          Int @id @default(autoincrement())
  ordenPagoId Int
  usuarioId   Int

  accion         AccionHistorialOrdenPago
  estadoAnterior EstadoOrdenPago?
  estadoNuevo    EstadoOrdenPago

  descripcion String?  @db.Text
  fecha       DateTime @default(now())

  ordenPago OrdenPago @relation(fields: [ordenPagoId], references: [id], onDelete: Restrict)

  usuario Usuario @relation("ResponsableHistorialOrdenPago", fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([ordenPagoId, fecha])
  @@index([usuarioId])
}
